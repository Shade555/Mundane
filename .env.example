# ==============================================================================
# MUNDANE — Environment Configuration Reference (.env.example)
# Copy this file to .env.local to configure your local or production environment.
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI Runtime — Ollama Local Inference (Primary Open-Weight Stack)
# Local Ollama endpoint (default: http://127.0.0.1:11434)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Open-weight text/reasoning model (e.g. gemma4:12b, gemma2:9b, gemma2:2b)
OLLAMA_MODEL=gemma4:12b

# Vision-capable open-weight model for photograph analysis (e.g. gemma4:12b, llava:7b)
OLLAMA_VISION_MODEL=gemma4:12b

# Optional Remote Inference Endpoint (e.g., when deployed on Render or cloud host)
# If provided, the application connects to this endpoint instead of localhost
REMOTE_INFERENCE_URL=
REMOTE_INFERENCE_API_KEY=

# Database & Authentication — Supabase (PostgreSQL with RLS)
# Leave empty to run in honest local-storage offline mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
